# Greyscale (btop "grayscale" ramp ANSI + koda-dark surfaces) — see themes/GREYSCALE.md
# ANSI 16 = btop ramp stretched (normals 00→ff, brights shifted one step); lazygit commit
# statuses use ANSI slots, so pushed/yellow now renders gray #737373. Surfaces from koda-dark
# (koda.nvim extras/ghostty/koda-dark.conf surfaces; ANSI kept ramp-gray, not koda's chromatic).
palette = 0=#000000
palette = 1=#404040
palette = 2=#505050
palette = 3=#737373
palette = 4=#909090
palette = 5=#BBBBBB
palette = 6=#CCCCCC
palette = 7=#FFFFFF
palette = 8=#404040
palette = 9=#505050
palette = 10=#737373
palette = 11=#909090
palette = 12=#BBBBBB
palette = 13=#CCCCCC
palette = 14=#FFFFFF
palette = 15=#FFFFFF
background = #101010
foreground = #bbbbbb
cursor-color = #b0b0b0
cursor-text = #101010
selection-background = #272727
selection-foreground = #b0b0b0

