# Looks good for screenshots, but not my fav for everyday :(
background-opacity = 0.965
background-blur-radius = 50
cursor-style = block
unfocused-split-opacity = 1
split-divider-color = #252525
# Icon
macos-icon = custom
macos-custom-icon = ~/dotfiles/.github/ghostty-icon-2.png
macos-icon-frame = plastic
macos-icon-ghost-color = #ffffff
macos-icon-screen-color = #181818

