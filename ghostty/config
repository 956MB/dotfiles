#  delta git diff pager in lazygit  uses these palette colors for it's
#  add/remove background color, and for some reason the 'palette = 235'
#  by default is gray. so I changed it to green to fix it.
#  (not exactly the VSCode green but I think it's better.)
palette = 52=#411F1D
palette = 235=#17351E
# Other greens I don't want to use but would work
# palette = 235=#1E3319
# palette = 235=#47552A

# Keybindings
# NOTE: Re bind goto_split so we can use left/right arrows
keybind = ctrl+shift+p=toggle_command_palette
keybind = super+alt+l=goto_split:right
keybind = super+alt+h=goto_split:left
keybind = super+alt+right=next_tab
keybind = super+alt+left=previous_tab
# Explicitly override these for gnome
keybind = super+t=new_tab
keybind = super+w=close_tab
keybind = super+alt+left=previous_tab
keybind = super+alt+right=next_tab
keybind = ctrl+enter=unbind

keybind = ctrl+up=csi:5~
keybind = ctrl+down=csi:6~

window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-save-state = always
quit-after-last-window-closed=true
macos-titlebar-style = hidden
mouse-hide-while-typing = true
gtk-titlebar-style = tabs

# shell-integration-features = ssh-terminfo,ssh-env
auto-update = off
