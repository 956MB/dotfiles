{
  "themes": {
    "kanso": {
      "display_name": "Kanso",
      "description": "Muted-ink color family. Dark theme that invites focus, not attention.",
      "style_guide": "themes/KANSO.md"
    },
    "matteblack": {
      "display_name": "Matte Black",
      "description": "Warm, high-contrast dark theme by tahayvr.",
      "style_guide": "themes/MATTEBLACK.md"
    },
    "greyscale": {
      "display_name": "Greyscale",
      "description": "Btop grayscale ramp with koda-dark ports and deep matte-black diff washes.",
      "style_guide": "themes/GREYSCALE.md"
    }
  },
  "tools": {
    "nvim": {
      "file": "nvim/lua/plugins/colorscheme.lua",
      "switch": "block",
      "active": {
        "kanso": {
          "uncomment": [
            "require('kanso').setup {",
            "    theme = 'zen',",
            "    background = {",
            "        dark = 'zen',",
            "    },",
            "}",
            "vim.cmd 'colorscheme kanso'"
          ],
          "comment_out": [
            "vim.cmd 'colorscheme matteblack'"
          ]
        },
        "matteblack": {
          "uncomment": [
            "vim.cmd 'colorscheme matteblack'"
          ],
          "comment_out": [
            "require('kanso').setup {",
            "    theme = 'zen',",
            "    background = {",
            "        dark = 'zen',",
            "    },",
            "}",
            "vim.cmd 'colorscheme kanso'"
          ]
        }
      }
    },
    "pi": {
      "file": "pi/settings.json",
      "switch": "json_key",
      "key": "theme",
      "values": {
        "kanso": "kanso",
        "matteblack": "matte-black"
      }
    },
    "opencode": {
      "file": "opencode/tui.json",
      "switch": "json_key",
      "key": "theme",
      "values": {
        "kanso": "kanso",
        "matteblack": "matte-black"
      }
    },
    "ghostty": {
      "file": "ghostty/config",
      "switch": "block",
      "active": {
        "kanso": {
          "uncomment_block": {
            "start_comment": "# Kanso Ink (previous theme — commented out, back up by uncommenting)",
            "lines": [
              "# palette = 0=#090E13",
              "# palette = 1=#d45c55",
              "# palette = 2=#799c66",
              "# palette = 3=#d4b473",
              "# palette = 4=#76abc3",
              "# palette = 5=#a87ea9",
              "# palette = 6=#7ab1ae",
              "# palette = 7=#d6be70",
              "# palette = 8=#9a9f9a",
              "# palette = 9=#f05068",
              "# palette = 10=#73b173",
              "# palette = 11=#f1c065",
              "# palette = 12=#69c3e1",
              "# palette = 13=#a87cc4",
              "# palette = 14=#65bcb0",
              "# palette = 15=#c1c6c3",
              "# background = #111111",
              "# foreground = #c5c9c7",
              "# cursor-color = #c5c9c7",
              "# selection-background = #24262D",
              "# selection-foreground = #c5c9c7"
            ]
          },
          "comment_out_block": {
            "start_line": "palette = 0=#333333",
            "end_line": "selection-foreground = #eaeaea"
          }
        },
        "matteblack": {
          "uncomment_block": {
            "start_comment": "# Matte Black (tahayvr/matte-black-theme) — warm repo palette (active)",
            "lines": [
              "palette = 0=#333333",
              "palette = 1=#D35F5F",
              "palette = 2=#FFC107",
              "palette = 3=#B91C1C",
              "palette = 4=#E68E0D",
              "palette = 5=#D35F5F",
              "palette = 6=#BEBEBE",
              "palette = 7=#BEBEBE",
              "palette = 8=#8A8A8D",
              "palette = 9=#B91C1C",
              "palette = 10=#FFC107",
              "palette = 11=#B90A0A",
              "palette = 12=#F59E0B",
              "palette = 13=#B91C1C",
              "palette = 14=#EAEAEA",
              "palette = 15=#FFFFFF",
              "background = #121212",
              "foreground = #bebebe",
              "cursor-color = #eaeaea",
              "cursor-text = #121212",
              "selection-background = #333333",
              "selection-foreground = #eaeaea"
            ]
          }
        }
      }
    },
    "zellij": {
      "file": "zellij/config.kdl",
      "switch": "replace_line",
      "active": {
        "kanso": {
          "find": "theme \"matte-black\"",
          "replace": "theme \"kanso\""
        },
        "matteblack": {
          "find": "theme \"kanso\"",
          "replace": "theme \"matte-black\""
        }
      }
    },
    "btop": {
      "file": "btop/btop.conf",
      "switch": "replace_line",
      "active": {
        "kanso": {
          "find": "color_theme = \"/Users/bays/.config/btop/themes/matte-black.theme\"",
          "replace": "color_theme = \"/Users/bays/.config/btop/themes/kanso.theme\""
        },
        "matteblack": {
          "find": "color_theme = \"/Users/bays/.config/btop/themes/kanso.theme\"",
          "replace": "color_theme = \"/Users/bays/.config/btop/themes/matte-black.theme\""
        }
      }
    },
    "bat": {
      "file": "bat/config",
      "switch": "replace_line",
      "active": {
        "kanso": {
          "find": "--theme=\"matte-black\"",
          "replace": "--theme=\"kanso\""
        },
        "matteblack": {
          "find": "--theme=\"kanso\"",
          "replace": "--theme=\"matte-black\""
        }
      },
      "post_switch": "bat cache --build"
    },
    "delta": {
      "file": ".gitconfig",
      "switch": "replace_line",
      "active": {
        "kanso": {
          "find": "syntax-theme = matte-black",
          "replace": "syntax-theme = kanso"
        },
        "matteblack": {
          "find": "syntax-theme = kanso",
          "replace": "syntax-theme = matte-black"
        }
      }
    },
    "lazygit": {
      "file": "lazygit/config.yml",
      "switch": "block",
      "active": {
        "kanso": {
          "uncomment_block": {
            "start_comment": "# previous kanso colors (switch back: uncomment these, comment the matte-black values below)",
            "lines": [
              "# activeBorderColor:",
              "#   - '#7c98c7'",
              "#   - bold",
              "# inactiveBorderColor:",
              "#   - '#868686'",
              "# optionsTextColor:",
              "#   - '#cb7f4f'",
              "# selectedLineBgColor:",
              "#   - '#52596a'",
              "# cherryPickedCommitBgColor:",
              "#   - '#111111' # keeping dark background",
              "# cherryPickedCommitFgColor:",
              "#   - '#a784ab'",
              "# unstagedChangesColor:",
              "#   - '#e03c30'",
              "# defaultFgColor:",
              "#   - '#CDCDCD'",
              "# searchingActiveBorderColor:",
              "#   - '#7ab0a8'"
            ]
          },
          "comment_out_block": {
            "start_line": "    # matte-black (tahayvr/matte-black-theme)",
            "end_line": "      - '#F59E0B'"
          },
          "replace_lines": {
            "# command: delta --syntax-theme \"kanso\"  --paging=never": "command: delta --syntax-theme \"kanso\" --paging=never",
            "command: delta --syntax-theme \"matte-black\" --paging=never": "# command: delta --syntax-theme \"matte-black\" --paging=never"
          }
        },
        "matteblack": {
          "comment_out_block": {
            "start_line": "    # previous kanso colors (switch back: uncomment these, comment the matte-black values below)",
            "end_line": "    #   - '#7ab0a8'"
          },
          "uncomment_block": {
            "start_comment": "    # matte-black (tahayvr/matte-black-theme)",
            "lines": [
              "    activeBorderColor:",
              "      - '#F59E0B'",
              "      - bold",
              "    inactiveBorderColor:",
              "      - '#8A8A8D'",
              "    optionsTextColor:",
              "      - '#D97706'",
              "    selectedLineBgColor:",
              "      - '#333333'",
              "    cherryPickedCommitBgColor:",
              "      - '#0D0D0D' # keeping dark background",
              "    cherryPickedCommitFgColor:",
              "      - '#10B981'",
              "    unstagedChangesColor:",
              "      - '#DC2626'",
              "    defaultFgColor:",
              "      - '#EAEAEA'",
              "    searchingActiveBorderColor:",
              "      - '#F59E0B'"
            ]
          },
          "replace_lines": {
            "# command: delta --syntax-theme \"kanso\"  --paging=never": "# command: delta --syntax-theme \"kanso\"  --paging=never",
            "command: delta --syntax-theme \"matte-black\" --paging=never": "command: delta --syntax-theme \"matte-black\" --paging=never"
          }
        }
      }
    },
    "yazi": {
      "file": "yazi/theme.toml",
      "switch": "replace_line",
      "active": {
        "kanso": {
          "find": "dark = \"matte-black\"",
          "replace": "dark = \"kanso\""
        },
        "matteblack": {
          "find": "dark = \"kanso\"",
          "replace": "dark = \"matte-black\""
        }
      }
    },
    "hunk": {
      "file": "hunk/config.toml",
      "switch": "manual",
      "note": "hunk has a large [custom_theme] block with ~40 color values and [custom_theme.syntax_scopes] with ~30 scope mappings. See themes/KANSO.md and themes/MATTEBLOCK.md for the full values. Swap the label, accent, panel, noteBorder, and all diff-color/syntax-scope values."
    },
    "herdr": {
      "file": "herdr/config.toml",
      "switch": "manual",
      "note": "herdr has [theme.custom] with ~12 color values and [ui] accent. Kanso values are partially commented (panel/surface lines are uncommented but colors are commented). Matte-black is the reverse. See the file for the exact commented/uncommented state."
    },
    "starship": {
      "file": "starship/starship.toml",
      "switch": "none",
      "note": "starship git segment uses truecolor escapes (palette-independent). No changes needed when switching themes."
    },
    "moshi": {
      "file": null,
      "switch": "manual",
      "note": "Moshi (iOS terminal) requires manual import: Settings → Theme → Import theme → paste contents of moshi/<theme>-theme.json"
    }
  }
}
