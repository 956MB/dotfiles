#!/bin/bash
# dot - personal dotfiles manager for macOS and Linux.
# Full setup, package checks, health diagnostics, and updates.
# Run with no arguments for the interactive menu, or `dot help` for usage.

set -e

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CHAR_INDEX=0

get_next_char() {
	case $CHAR_INDEX in
	0)
		CHAR_OUT="|"
		CHAR_INDEX=1
		;;
	1)
		CHAR_OUT="/"
		CHAR_INDEX=2
		;;
	2)
		CHAR_OUT="-"
		CHAR_INDEX=3
		;;
	3)
		CHAR_OUT="\\"
		CHAR_INDEX=0
		;;
	esac
}

log() {
	get_next_char
	echo -e "$CHAR_OUT  $1"
}
log_success() {
	get_next_char
	printf "\033[0;32m%s\033[0m  %s\n" "$CHAR_OUT" "$1"
}
log_warning() {
	get_next_char
	printf "\033[1;33m%s\033[0m  %s\n" "$CHAR_OUT" "$1"
}
log_error() {
	get_next_char
	printf "\033[0;31m%s\033[0m  %s\n" "$CHAR_OUT" "$1"
}
log_blank() {
	get_next_char
	echo -e "$CHAR_OUT  "
}
log_start() {
	echo -e "*  $1"
}
log_end() {
	echo -e "*  $1"
}

detect_system() {
	if [[ "$OSTYPE" == "darwin"* ]]; then
		OS="macos"
		if [[ $(uname -m) == "arm64" ]]; then
			ARCH="arm64"
			HOMEBREW_PREFIX="/opt/homebrew"
		else
			ARCH="x86_64"
			HOMEBREW_PREFIX="/usr/local"
		fi
	elif [[ "$OSTYPE" == "linux-gnu"* ]] || [[ "$OSTYPE" == "linux-musl"* ]] || [[ "$OSTYPE" == "linux"* ]]; then
		OS="linux"
		ARCH=$(uname -m)
		HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew"
	else
		log_error "Unsupported: $OSTYPE"
		exit 1
	fi

	log "Detected: $OS ($ARCH)"
}

exists() {
	command -v "$1" >/dev/null 2>&1
}

AGENT_BACKUP_PATHS=(".claude/skills" ".opencode/skills" ".agents" ".agents/skills" ".agents/.skill-lock.json")
AGENT_LINK_PATHS=(".claude/skills" ".opencode/skills" ".agents/skills" ".agents/.skill-lock.json")

backup_path() {
	local rel="$1"
	local src="$HOME/$rel"

	if [[ ! -e "$src" || -L "$src" ]]; then
		return 0
	fi

	mkdir -p "$BACKUP_DIR/$(dirname "$rel")"
	log "    Backing up ~/$rel"
	mv "$src" "$BACKUP_DIR/$rel"
}

remove_symlink() {
	local rel="$1"
	local src="$HOME/$rel"

	if [[ -L "$src" ]]; then
		rm "$src"
		log_success "    Removed ~/$rel symlink"
	fi
}

restore_path() {
	local rel="$1"
	local src="$BACKUP_DIR/$rel"

	if [[ ! -e "$src" || -e "$HOME/$rel" ]]; then
		return 0
	fi

	mkdir -p "$HOME/$(dirname "$rel")"
	mv "$src" "$HOME/$rel"
	log_success "    Restored ~/$rel"
}

ask_confirmation() {
	local prompt="$1"
	local default="${2:-n}"

	if [[ "$default" == "y" ]]; then
		echo -n "$prompt [Y/n]: "
	else
		echo -n "$prompt [y/N]: "
	fi

	read -r response
	case "$response" in
	[yY][eE][sS] | [yY])
		return 0
		;;
	[nN][oO] | [nN])
		return 1
		;;
	"")
		if [[ "$default" == "y" ]]; then
			return 0
		else
			return 1
		fi
		;;
	*)
		return 1
		;;
	esac
}

backup_configs() {
	log "Backing up existing configs..."
	BACKUP_DIR="$HOME/.config-backup-$(date +%Y%m%d_%H%M%S)"
	mkdir -p "$BACKUP_DIR"

	configs=("bat" "btop" "delta" "fish" "ghostty" "herdr" "nvim" "rex" "yazi" "zed" "zellij" "starship.toml" "opencode")

	for config in "${configs[@]}"; do
		if [[ -e "$HOME/.config/$config" ]]; then
			log "    Backing up ~/.config/$config"
			mv "$HOME/.config/$config" "$BACKUP_DIR/$config"
		fi
	done

	# Back up agent config paths if they're not symlinks
	for path in "${AGENT_BACKUP_PATHS[@]}"; do
		backup_path "$path"
	done

	for item in "$HOME/.pi/agent"/*; do
		[[ -L "$item" || -e "$item" ]] || continue
		backup_path ".pi/agent/$(basename "$item")"
	done

	if [[ -e "$HOME/.gitconfig" ]]; then
		log "    Backing up ~/.gitconfig"
		mv "$HOME/.gitconfig" "$BACKUP_DIR/.gitconfig"
	fi

	# Store shell info for potential revert
	echo "$SHELL" >"$BACKUP_DIR/.previous_shell"

	log_success "Backup completed in $BACKUP_DIR"
}

install_ruby_linux() {
	if [[ "$OS" != "linux" ]]; then
		return
	fi

	if exists ruby; then
		local ruby_version
		ruby_version=$(ruby --version 2>/dev/null || echo "unknown")
		log_success "Ruby already installed: $ruby_version"
		log "    Ruby location: $(which ruby)"
		return
	fi

	log "Installing Ruby (required for Homebrew on Linux)..."
	log "Package manager detection:"

	for cmd in dnf yum dnf5 apt-get apk pacman; do
		if exists "$cmd"; then
			log "    Found: $cmd -> $(command -v $cmd)"
		fi
	done

	if exists dnf; then
		sudo dnf group install -y development-tools
		sudo dnf install -y ruby ruby-devel git
	elif exists apk; then
		sudo apk add --no-cache ruby ruby-dev build-base git
	elif exists apt-get; then
		sudo apt-get update && sudo apt-get install -y ruby ruby-dev build-essential git
	elif exists pacman; then
		sudo pacman -S --noconfirm ruby base-devel git
	else
		log_warning "Could not install Ruby automatically. Please install Ruby manually."
		return 1
	fi

	if exists ruby; then
		local ruby_version
		ruby_version=$(ruby --version 2>/dev/null || echo "unknown")
		log_success "Ruby installed: $ruby_version"
		log "    Ruby location: $(which ruby)"
	else
		log_error "Ruby installation failed"
		return 1
	fi
}

install_homebrew() {
	if exists brew; then
		log_success "Homebrew already installed"
		return
	fi

	if [[ "$OS" == "linux" ]]; then
		install_ruby_linux
	fi

	log "Installing Homebrew..."

	export NONINTERACTIVE=1

	if ! curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh >/dev/null 2>&1; then
		log_error "Failed to download Homebrew install script"
		return 1
	fi

	if bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"; then
		if [[ "$OS" == "linux" ]]; then
			eval "$($HOMEBREW_PREFIX/bin/brew shellenv)"
		elif [[ "$OS" == "macos" && "$ARCH" == "arm64" ]]; then
			eval "$($HOMEBREW_PREFIX/bin/brew shellenv)"
		fi
		log_success "Homebrew installed"
	else
		log_error "Homebrew installation failed"
		log "Trying to continue without Homebrew..."
		return 1
	fi
}

clone_dotfiles() {
	if [[ -d "$HOME/dotfiles" ]]; then
		log_warning "~/dotfiles already exists. Pulling latest changes..."
		cd "$HOME/dotfiles"
		git pull origin main || {
			log_warning "    Failed to pull latest changes, continuing with existing dotfiles"
		}
	else
		log "Cloning dotfiles repository..."
		git clone https://github.com/956MB/dotfiles.git "$HOME/dotfiles" || {
			log_error "Failed to clone dotfiles repository"
			exit 1
		}
	fi

	log_success "Dotfiles repository ready"
}

safe_link() {
	local target="$1" dest="$2"
	if [[ -e "$dest" && ! -L "$dest" ]]; then
		log_warning "    $dest is a real directory - moving aside to $dest.bak-$(date +%Y%m%d_%H%M%S)"
		mv "$dest" "$dest.bak-$(date +%Y%m%d_%H%M%S)"
	fi
	ln -sfn "$target" "$dest"
}

create_symlinks() {
	log "Creating symlinks..."
	mkdir -p "$HOME/.config"

	configs=("bat" "btop" "delta" "fish" "ghostty" "herdr" "nvim" "rex" "yazi" "zed" "zellij" "starship.toml" "opencode")

	for config in "${configs[@]}"; do
		if [[ ! -d "$HOME/dotfiles/$config" ]]; then
			log_warning "    Config directory $config not found in dotfiles"
			continue
		fi
		if [[ -e "$HOME/.config/$config" && ! -L "$HOME/.config/$config" ]]; then
			log_warning "    ~/.config/$config is a real file/dir (not a symlink) - skipping to avoid clobbering"
			continue
		fi
		ln -sfn "$HOME/dotfiles/$config" "$HOME/.config/$config"
		log_success "    Linked ~/.config/$config"
	done

	log "Linking skill paths..."
	if [[ -d "$HOME/dotfiles/opencode/skills" ]]; then
		mkdir -p "$HOME/.claude"
		safe_link "$HOME/dotfiles/opencode/skills" "$HOME/.claude/skills"
		log_success "    Linked ~/.claude/skills"

		mkdir -p "$HOME/.opencode"
		safe_link "$HOME/dotfiles/opencode/skills" "$HOME/.opencode/skills"
		log_success "    Linked ~/.opencode/skills"

		# ~/.agents must be a real directory so the lock file and skills can be separate symlinks
		# (~/.agents/.skill-lock.json is where npx skills reads/writes the global lock)
		mkdir -p "$HOME/.agents"
		safe_link "$HOME/dotfiles/opencode/skills" "$HOME/.agents/skills"
		log_success "    Linked ~/.agents/skills"
		if [[ -f "$HOME/dotfiles/opencode/.skill-lock.json" ]]; then
			ln -sfn "$HOME/dotfiles/opencode/.skill-lock.json" "$HOME/.agents/.skill-lock.json"
			log_success "    Linked ~/.agents/.skill-lock.json"
		fi
	else
		log_warning "    ~/dotfiles/opencode/skills not found (skills not linked)"
	fi

	log "Linking pi agent paths..."
	if [[ -d "$HOME/dotfiles/pi" ]]; then
		mkdir -p "$HOME/.pi/agent"
		for item in "$HOME/dotfiles/pi"/*; do
			[[ -e "$item" ]] || continue
			safe_link "$item" "$HOME/.pi/agent/$(basename "$item")"
			log_success "    Linked ~/.pi/agent/$(basename "$item")"
		done
	else
		log_warning "    ~/dotfiles/pi not found (pi agent paths not linked)"
	fi

	if [[ -f "$HOME/dotfiles/starship/starship.toml" ]]; then
		ln -sf "$HOME/dotfiles/starship/starship.toml" "$HOME/.config/starship.toml"
		log_success "    Linked ~/.config/starship.toml"
	else
		log_warning "    starship.toml not found in dotfiles/starship/"
	fi

	if [[ -f "$HOME/dotfiles/.gitconfig" ]]; then
		if ask_confirmation "Link .gitconfig? (This will replace current git configuration)"; then
			ln -sf "$HOME/dotfiles/.gitconfig" "$HOME/.gitconfig"
			log_success "    Linked ~/.gitconfig"
		else
			log "    Skipped linking .gitconfig"
		fi
	else
		log_warning "    .gitconfig not found in dotfiles"
	fi
}

install_packages() {
	if [[ ! -f "$HOME/dotfiles/Brewfile" ]]; then
		log_warning "Brewfile not found, skipping package installation"
		return
	fi

	if ! ask_confirmation "Install additional packages from Brewfile? (development tools, utilities)"; then
		log "Skipping package installation"
		return
	fi

	log "Installing packages from Brewfile..."

	brew update || {
		log_warning "Failed to update Homebrew, continuing with installation"
	}

	if [[ "$OS" == "linux" ]]; then
		log "    Installing core packages (GUI apps not supported on Linux)"
		brew bundle --file="$HOME/dotfiles/Brewfile" || {
			log_warning "Some packages failed to install, continuing..."
		}
	else
		if ask_confirmation "Install GUI applications? (browsers, editors, utilities)"; then
			log "    Installing all packages including GUI applications..."
			brew bundle --file="$HOME/dotfiles/Brewfile" || {
				log_warning "Some packages failed to install, continuing..."
			}
		else
			log "    Installing core packages only (skipping GUI applications)..."
			brew bundle --file="$HOME/dotfiles/Brewfile" --no-cask || {
				log_warning "Some packages failed to install, continuing..."
			}
		fi
	fi

	log_success "Package installation completed"
}

install_fish_tools() {
	if ! exists brew; then
		log_warning "Homebrew not available, skipping Fish tools installation"
		return 1
	fi

	log "Installing essential Fish shell tools..."

	local tools=("eza" "starship" "zoxide" "zellij" "herdr")

	for tool in "${tools[@]}"; do
		if exists "$tool"; then
			log_success "$tool already installed"
		else
			log "    Installing $tool..."
			brew install "$tool" || {
				log_warning "Failed to install $tool, continuing..."
			}
		fi
	done

	log_success "Fish tools installation completed"
}

set_fish_shell() {
	if ! exists brew; then
		log_warning "Homebrew not available, skipping Fish shell setup"
		return 1
	fi

	log "Installing Fish shell..."
	brew install fish || {
		log_error "Failed to install Fish shell"
		return 1
	}

	FISH_PATH="$HOMEBREW_PREFIX/bin/fish"

	if [[ ! -f "$FISH_PATH" ]]; then
		log_error "Fish shell not found at $FISH_PATH after installation"
		return 1
	fi

	if [[ "$SHELL" == "$FISH_PATH" ]]; then
		log_success "Fish is already the default shell"
		return
	fi

	log "Setting Fish as default shell..."

	if ! grep -q "$FISH_PATH" /etc/shells 2>/dev/null; then
		log "    Adding fish to /etc/shells (requires sudo)"
		echo "$FISH_PATH" | sudo tee -a /etc/shells >/dev/null || {
			log_error "Failed to add fish to /etc/shells"
			return 1
		}
	fi

	chsh -s "$FISH_PATH" || {
		log_error "Failed to change default shell to fish"
		return 1
	}

	log_success "Fish installed"
}

# --- Reporting and maintenance commands --------------------------------------

check_packages() {
	local brewfile="$HOME/dotfiles/Brewfile"

	if [[ ! -f "$brewfile" ]]; then
		log_error "Brewfile not found at $brewfile"
		return 1
	fi

	if ! exists brew; then
		log_error "Homebrew is not installed"
		return 1
	fi

	log "Checking Brewfile packages..."

	local formula_list cask_list
	formula_list=$(brew list --formula 2>/dev/null || true)
	cask_list=$(brew list --cask 2>/dev/null || true)

	local installed=0 missing=0 package kind
	local missing_list=()

	while IFS= read -r line; do
		[[ -z "$line" || "$line" == \#* ]] && continue
		case "$line" in
		"tap "* | "mas "*) continue ;; # taps and App Store apps are not checked
		"brew "*) kind="brew" ;;
		"cask "*) kind="cask" ;;
		*) continue ;;
		esac

		package=$(echo "$line" | awk '{print $2}' | tr -d '"')
		[[ -z "$package" ]] && continue

		if [[ "$kind" == "brew" ]]; then
			if grep -qx "$package" <<<"$formula_list"; then
				installed=$((installed + 1))
			else
				missing=$((missing + 1))
				missing_list+=("$package")
			fi
		else
			if grep -qx "$package" <<<"$cask_list"; then
				installed=$((installed + 1))
			else
				missing=$((missing + 1))
				missing_list+=("$package (cask)")
			fi
		fi
	done <"$brewfile"

	log_success "$installed installed, $missing missing"

	if [[ $missing -gt 0 ]]; then
		log_warning "Missing packages:"
		printf "    %s\n" "${missing_list[@]}"
		log "    Install them with: dot packages"
		return 1
	fi
}

cmd_update() {
	log_start "Updating dotfiles..."
	detect_system

	if [[ -d "$HOME/dotfiles" ]]; then
		cd "$HOME/dotfiles" && git pull --ff-only origin main || {
			log_warning "    Pull failed, continuing with local copy"
		}
	else
		clone_dotfiles
	fi

	ensure_completions
	create_symlinks

	if exists brew; then
		log "Updating Homebrew..."
		brew update || log_warning "    brew update failed"

		if ask_confirmation "Upgrade installed packages? (brew upgrade)"; then
			brew upgrade || log_warning "    brew upgrade had failures, continuing"
		fi

		log "Syncing Brewfile (installs anything new)..."
		brew bundle --file="$HOME/dotfiles/Brewfile" || {
			log_warning "    Some packages failed to install"
		}
	else
		log_warning "Homebrew not available, skipping package updates"
	fi

	log_end "Update complete"
}

cmd_doctor() {
	detect_system

	local issues=0

	log "Checking core tools..."
	local tools=(git brew fish nvim zellij herdr starship zoxide eza yazi lazygit)
	for tool in "${tools[@]}"; do
		if exists "$tool"; then
			log_success "$tool found"
		else
			log_warning "$tool missing"
			issues=$((issues + 1))
		fi
	done

	log "Checking config symlinks..."
	local configs=("bat" "btop" "delta" "fish" "ghostty" "herdr" "nvim" "rex" "yazi" "zed" "zellij" "opencode")
	for config in "${configs[@]}"; do
		local dest="$HOME/.config/$config"
		if [[ -L "$dest" && "$(readlink "$dest")" == "$HOME/dotfiles"* ]]; then
			log_success "~/.config/$config -> dotfiles"
		elif [[ -e "$dest" ]]; then
			log_warning "~/.config/$config exists but is not linked to dotfiles"
			issues=$((issues + 1))
		else
			log_warning "~/.config/$config missing (run: dot symlinks)"
			issues=$((issues + 1))
		fi
	done

	local special=("$HOME/.config/starship.toml" "$HOME/.gitconfig" "$HOME/.agents/skills")
	for dest in "${special[@]}"; do
		if [[ -L "$dest" && "$(readlink "$dest")" == "$HOME/dotfiles"* ]]; then
			log_success "$dest -> dotfiles"
		else
			log_warning "$dest is not linked to dotfiles"
			issues=$((issues + 1))
		fi
	done

	log "Checking shell..."
	if [[ "$SHELL" == *fish ]]; then
		log_success "Fish is the default shell"
	else
		log_warning "Default shell is $SHELL, not fish"
		issues=$((issues + 1))
	fi

	if [[ $issues -eq 0 ]]; then
		log_end "All checks passed"
	else
		log_end "$issues issue(s) found"
		return 1
	fi
}

cmd_gen_ssh_key() {
	local email="$1"

	if [[ -z "$email" ]]; then
		read -r -p "Email for the SSH key (used as the key comment): " email
	fi

	if [[ -z "$email" ]]; then
		log_error "No email provided"
		return 1
	fi

	local key_path="$HOME/.ssh/id_ed25519"
	mkdir -p "$HOME/.ssh"
	chmod 700 "$HOME/.ssh"

	if [[ -f "$key_path" ]]; then
		log_warning "A key already exists at $key_path"
		if ! ask_confirmation "Generate a new key anyway? (this overwrites it)"; then
			log "    Keeping the existing key"
			return 0
		fi
	fi

	if ! ssh-keygen -t ed25519 -C "$email" -f "$key_path" -N ""; then
		log_error "Failed to generate SSH key"
		return 1
	fi

	log_success "SSH key ready at $key_path.pub"
	log "    Add it to GitHub: Settings > SSH and GPG keys > New SSH key"

	if exists pbcopy; then
		pbcopy <"$key_path.pub" && log "    Public key copied to clipboard"
	elif exists wl-copy; then
		wl-copy <"$key_path.pub" && log "    Public key copied to clipboard"
	else
		log "    Public key:"
		cat "$key_path.pub"
	fi
}

# --- Fish completions --------------------------------------------------------

# --- Global link -------------------------------------------------------------

cmd_link() {
	local bin_dir=""

	# Prefer user-writable dirs that are already on PATH.
	for candidate in "$HOME/.local/bin" "/usr/local/bin"; do
		if [[ -d "$candidate" && -w "$candidate" ]] && echo "$PATH" | tr ':' '\n' | grep -qx "$candidate"; then
			bin_dir="$candidate"
			break
		fi
	done

	if [[ -z "$bin_dir" ]]; then
		bin_dir="/usr/local/bin"
		log "    $bin_dir will need sudo"
		sudo ln -sf "$DOTFILES_DIR/dot" "$bin_dir/dot" || {
			log_error "Failed to link dot into $bin_dir"
			return 1
		}
	else
		ln -sf "$DOTFILES_DIR/dot" "$bin_dir/dot" || {
			log_error "Failed to link dot into $bin_dir"
			return 1
		}
	fi

	log_success "dot linked: $bin_dir/dot -> $DOTFILES_DIR/dot"
	log "    Fish completions will now autoload for dot in new shells"
}

cmd_unlink() {
	local target=""
	for candidate in "$HOME/.local/bin/dot" "$HOMEBREW_PREFIX/bin/dot" "/usr/local/bin/dot"; do
		if [[ -L "$candidate" ]]; then
			target="$candidate"
			break
		fi
	done

	if [[ -z "$target" ]]; then
		log_warning "No dot symlink found in ~/.local/bin, \$HOMEBREW_PREFIX/bin, or /usr/local/bin"
		return 1
	fi

	if [[ "$(readlink "$target")" == "$DOTFILES_DIR"* ]]; then
		rm "$target"
		log_success "Removed $target"
	else
		log_error "$target is not a symlink into $DOTFILES_DIR, not removing it"
		return 1
	fi
}

cmd_completions() {
	local completions_dir="${1:-$DOTFILES_DIR/fish/completions}"
	local completions_file="$completions_dir/dot.fish"

	if ! exists fish; then
		log_error "Fish shell is not installed"
		log "    Install Fish shell first: brew install fish"
		return 1
	fi

	mkdir -p "$completions_dir"

	log "Generating Fish completions at $completions_file..."

	cat >"$completions_file" <<'EOF'
# Fish shell completions for dot
# Generated by: dot completions

complete -c dot -f

complete -c dot -n "__fish_use_subcommand" -a "init" -d "Full setup: backup, Homebrew, clone, symlinks, packages, fish shell"
complete -c dot -n "__fish_use_subcommand" -a "symlinks" -d "Link/relink configs only"
complete -c dot -n "__fish_use_subcommand" -a "packages" -d "Install Brewfile packages only"
complete -c dot -n "__fish_use_subcommand" -a "update" -d "Pull dotfiles, re-link, brew update/upgrade + bundle"
complete -c dot -n "__fish_use_subcommand" -a "check-packages" -d "Installed vs missing Brewfile packages"
complete -c dot -n "__fish_use_subcommand" -a "doctor" -d "Health check: tools, symlinks, shell"
complete -c dot -n "__fish_use_subcommand" -a "gen-ssh-key" -d "Generate an ed25519 SSH key"
complete -c dot -n "__fish_use_subcommand" -a "revert" -d "Restore from the most recent backup"
complete -c dot -n "__fish_use_subcommand" -a "completions" -d "Generate Fish completions"
complete -c dot -n "__fish_use_subcommand" -a "help" -d "Show help"

complete -c dot -n "__fish_seen_subcommand_from init" -l skip-ssh -d "Skip SSH key generation"
complete -c dot -n "__fish_seen_subcommand_from init" -l help -d "Show help"
EOF

	log_success "Completions generated (reload fish or start a new shell to pick them up)"
}

# Regenerate completions when the script runs and the repo is already cloned.
# On a fresh curl|bash install the repo does not exist yet, so this is a no-op;
# clone_dotfiles + the next run will pick it up.
ensure_completions() {
	[[ -d "$HOME/dotfiles/.git" ]] || return 0
	cmd_completions "$HOME/dotfiles/fish/completions"
}

setup_ssh_key() {
	if [[ "$SKIP_SSH" == "true" ]]; then
		log "Skipping SSH key setup (--skip-ssh)"
		return
	fi

	if [[ -f "$HOME/.ssh/id_ed25519" ]]; then
		log_success "SSH key already exists"
		return
	fi

	if ask_confirmation "Generate an SSH key for this machine? (used for GitHub remotes and SSH commit signing)"; then
		cmd_gen_ssh_key
	fi
}

full_install() {
	log_start "Starting dotfiles installation..."
	detect_system
	ensure_completions
	backup_configs
	install_homebrew
	clone_dotfiles
	create_symlinks
	install_packages
	install_fish_tools
	set_fish_shell
	setup_ssh_key
	log_success "Dotfiles installation completed!"
	log_end "Initializing Fish shell ($FISH_PATH)..."

	exec "$FISH_PATH"
}

