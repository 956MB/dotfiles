{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg0": "#0D0D0D",
    "bg1": "#121212",
    "bg2": "#333333",
    "bg3": "#212121",
    "bg4": "#262626",
    "fg0": "#FFFFFF",
    "fg1": "#EAEAEA",
    "fg2": "#BEBEBE",
    "fg3": "#8A8A8D",
    "gray": "#8A8A8D",
    "gray1": "#A3A3A3",
    "gray2": "#737373",
    "red": "#B91C1C",
    "crimson": "#DC2626",
    "orange": "#F59E0B",
    "amber": "#D97706",
    "yellow": "#FBBF24",
    "gold": "#EFBF04",
    "ochre": "#BF9903",
    "green": "#059669",
    "teal": "#10B981",
    "blue": "#3B82F6",
    "purple": "#8D20B2",
    "cyan": "#1EA7A0",
    "pink": "#F87171",
    "magenta": "#B027DE",
    "washAdd": "#0D221B",
