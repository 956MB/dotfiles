    "diffAddedLineNumberBg": { "dark": "washAdd", "light": "washAdd" },
    "diffRemovedLineNumberBg": { "dark": "washDel", "light": "washDel" },
    "markdownText": { "dark": "fg1", "light": "fg1" },
    "markdownHeading": { "dark": "amber", "light": "amber" },
    "markdownLink": { "dark": "orange", "light": "orange" },
    "markdownLinkText": { "dark": "teal", "light": "teal" },
    "markdownCode": { "dark": "fg1", "light": "fg1" },
    "markdownBlockQuote": { "dark": "fg3", "light": "fg3" },
    "markdownEmph": { "dark": "crimson", "light": "crimson" },
