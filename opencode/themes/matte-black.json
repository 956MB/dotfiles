    "markdownHorizontalRule": { "dark": "bg2", "light": "bg2" },
    "markdownListItem": { "dark": "orange", "light": "orange" },
    "markdownListEnumeration": { "dark": "teal", "light": "teal" },
    "markdownImage": { "dark": "orange", "light": "orange" },
    "markdownImageText": { "dark": "teal", "light": "teal" },
    "markdownCodeBlock": { "dark": "fg1", "light": "fg1" },
    "syntaxComment": { "dark": "fg3", "light": "fg3" },
    "syntaxKeyword": { "dark": "green", "light": "green" },
    "syntaxFunction": { "dark": "crimson", "light": "crimson" },
    "syntaxVariable": { "dark": "fg1", "light": "fg1" },
    "syntaxString": { "dark": "fg1", "light": "fg1" },
    "syntaxNumber": { "dark": "gold", "light": "gold" },
    "syntaxType": { "dark": "yellow", "light": "yellow" },
    "syntaxOperator": { "dark": "fg2", "light": "fg2" },
    "syntaxPunctuation": { "dark": "fg3", "light": "fg3" }
