    "text": { "dark": "fg1", "light": "fg1" },
    "textMuted": { "dark": "fg3", "light": "fg3" },
    "background": { "dark": "none", "light": "none" },
    "backgroundPanel": { "dark": "bg3", "light": "bg3" },
    "backgroundElement": { "dark": "bg2", "light": "bg2" },
    "border": { "dark": "bg2", "light": "bg2" },
    "borderActive": { "dark": "fg3", "light": "fg3" },
    "borderSubtle": { "dark": "bg4", "light": "bg4" },
    "diffAdded": { "dark": "teal", "light": "teal" },
    "diffRemoved": { "dark": "crimson", "light": "crimson" },
    "diffContext": { "dark": "fg3", "light": "fg3" },
    "diffHunkHeader": { "dark": "bg2", "light": "bg2" },
    "diffHighlightAdded": { "dark": "teal", "light": "teal" },
    "diffHighlightRemoved": { "dark": "crimson", "light": "crimson" },
    "diffAddedBg": { "dark": "washAdd", "light": "washAdd" },
    "diffRemovedBg": { "dark": "washDel", "light": "washDel" },
    "diffContextBg": { "dark": "bg3", "light": "bg3" },
