    "markdownListEnumeration": { "dark": "info", "light": "info" },
    "markdownImage": { "dark": "warning", "light": "warning" },
    "markdownImageText": { "dark": "info", "light": "info" },
    "markdownCodeBlock": { "dark": "fg1", "light": "fg1" },
    "syntaxComment": { "dark": "fg3", "light": "fg3" },
    "syntaxKeyword": { "dark": "fg2", "light": "fg2" },
    "syntaxFunction": { "dark": "fg0", "light": "fg0" },
    "syntaxVariable": { "dark": "fg1", "light": "fg1" },
    "syntaxString": { "dark": "fg0", "light": "fg0" },
    "syntaxNumber": { "dark": "warning", "light": "warning" },
