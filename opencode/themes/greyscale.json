    "backgroundElement": { "dark": "bg2", "light": "bg2" },
    "border": { "dark": "bg2", "light": "bg2" },
    "borderActive": { "dark": "fg3", "light": "fg3" },
    "borderSubtle": { "dark": "bg4", "light": "bg4" },
