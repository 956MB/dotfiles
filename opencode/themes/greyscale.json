    "bg4": "#474747",
    "fg0": "#ffffff",
    "fg1": "#b0b0b0",
    "fg2": "#777777",
    "fg3": "#505050",
    "gray": "#474747",
    "gray1": "#777777",
    "gray2": "#505050",
    "red": "#701516",
    "crimson": "#ff7676",
    "orange": "#ff5733",
    "amber": "#d9ba73",
    "yellow": "#777777",
    "gold": "#d9ba73",
    "ochre": "#d9ba73",
    "green": "#14ba19",
    "teal": "#86cd82",
    "blue": "#8ebeec",
    "purple": "#f2a4db",
    "cyan": "#5abfb5",
    "pink": "#f2a4db",
