[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = 956MB
	email = bays@956mb.com
	signingkey = ~/.ssh/id_githubmacos2025.pub
[push]
	default = current
[init]
	defaultBranch = main
[sendpack]
	sideband = false
[http]
	lowSpeedLimit = 1000
	lowSpeedTime = 20
	postBuffer = 524288000
	sslBackend = openssl
[core]
	compression = 9
	whitespace = error
	preloadindex = true
	pager = hunk pager
[url "git@github.com:"]
	insteadOf = "gh:"
[url "git@github.com:956MB/"]
	insteadOf = "956:"

[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

# Delta diff pager syntax theme (greyscale = koda-dark colors, see themes/GREYSCALE.md).
# Diff background washes: DEEP matte-black green/red (user preference — deeper than koda blends).
# NOTE: delta 0.18.x reads config ONLY from git config, not ~/.config/delta/delta.toml.
# koda-blend washes (replaced 2026-09-08): plus "#283627"/emph "#3f5c3e", minus "#402424"/emph "#703939"
[delta]
	syntax-theme = greyscale
	plus-style = syntax "#0D221B"
	plus-non-emph-style = syntax "#0D221B"
	plus-emph-style = syntax "#0E402F"
	minus-style = normal "#261010"
	minus-non-emph-style = normal "#261010"
	minus-emph-style = normal "#4A1414"
