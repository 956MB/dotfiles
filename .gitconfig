[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = 956MB
	email = bays@956mb.com
	signingkey = ~/.ssh/id_ed25519.pub
[push]
	default = current
[init]
	defaultBranch = main
[sendpack]
	sideband = false
[http]
	lowSpeedLimit = 1000
	lowSpeedTime = 20
	postBuffer = 524288000
	sslBackend = openssl
[core]
	compression = 9
	whitespace = error
	preloadindex = true
	pager = hunk pager
[url "git@github.com:"]
	insteadOf = "gh:"
[url "git@github.com:956MB/"]
	insteadOf = "956:"

[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

# Delta diff pager syntax theme + diff background washes (matte-black theme).
# NOTE: delta 0.18.x reads config ONLY from git config, not ~/.config/delta/delta.toml
# (see KANSO.md). Wash colors mirror pi/themes/matte-black.json.
[delta]
	syntax-theme = matte-black
	plus-style = syntax "#0D221B"
	plus-non-emph-style = syntax "#0D221B"
	plus-emph-style = syntax "#0E402F"
	minus-style = normal "#261010"
	minus-non-emph-style = normal "#261010"
	minus-emph-style = normal "#4A1414"
