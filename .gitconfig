[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = 956MB
	email = bays@956mb.com
	signingkey = ~/.ssh/id_githubmacos2025.pub
[push]
	default = current
[init]
	defaultBranch = main
[sendpack]
	sideband = false
[http]
	lowSpeedLimit = 1000
	lowSpeedTime = 20
	postBuffer = 524288000
	sslBackend = openssl
[core]
	compression = 9
	whitespace = error
	preloadindex = true
	pager = hunk pager
[url "git@github.com:"]
	insteadOf = "gh:"
[url "git@github.com:956MB/"]
	insteadOf = "956:"

[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

# Delta diff pager syntax theme — appearance driven since 2026-09 (see themes/GREYSCALE.md).
# [delta] activates the dark half ("greyscale" feature); fish/functions/appearance_sync.fish exports
# DELTA_FEATURES=greyscale-light in light mode, and delta applies environment features AFTER the
# configured ones, so the light half wins. Each half owns its syntax theme AND its diff washes,
# because the washes are per-appearance (dark: deep matte-black, light: pale tints).
# NOTE: delta 0.18.x reads config ONLY from git config, not ~/.config/delta/delta.toml.
# (koda-blend washes replaced 2026-09-08: plus "#283627"/emph "#3f5c3e", minus "#402424"/emph "#703939")
[delta]
	features = greyscale
[delta "greyscale"]
	# dark half — koda-dark syntax (delta/themes/greyscale.tmTheme), deep matte-black washes
	syntax-theme = greyscale
	plus-style = syntax "#0D221B"
	plus-non-emph-style = syntax "#0D221B"
	plus-emph-style = syntax "#0E402F"
	minus-style = normal "#261010"
	minus-non-emph-style = normal "#261010"
	minus-emph-style = normal "#4A1414"
[delta "greyscale-light"]
	# light half — koda-light syntax (delta/themes/greyscale-light.tmTheme) on white, pale washes.
	# "light" is also inferred from the theme name; setting it keeps delta's own chrome (file/hunk
	# headers, line numbers) on its light defaults.
	light = true
	syntax-theme = greyscale-light
	plus-style = syntax "#DCF0D9"
	plus-non-emph-style = syntax "#DCF0D9"
	plus-emph-style = syntax "#B4E3AC"
	minus-style = normal "#FFE4E0"
	minus-non-emph-style = normal "#FFE4E0"
	minus-emph-style = normal "#FFC9C2"
